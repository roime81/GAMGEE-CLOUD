AUTHENTIK_POSTGRES_PASSWORD=replace-with-a-long-random-password
AUTHENTIK_SECRET_KEY=replace-with-a-long-random-secret

# AI Factory (docker-compose.ai-factory.yml)
GAMGEE_API_TOKEN=replace-with-a-long-random-token
FACTORY_POSTGRES_PASSWORD=replace-with-a-long-random-password
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=llama3.1:8b
# EMBEDDING_MODEL=nomic-embed-text
# JSON allowlist of MCP servers (Streamable HTTP), e.g. {"db":"http://mcp-db:8000/mcp"}
# MCP_SERVERS=
# OIDC login (optional). When set, JWTs are verified and the tenant comes from the token claim.
# OIDC_ISSUER=https://auth.example.com/application/o/gamgee/
# OIDC_AUDIENCE=gamgee
# OIDC_JWKS_URL=   # defaults to <issuer>/jwks/
# OIDC_TENANT_CLAIM=tenant
